{
  "name": "minecraft-kit-bot",
  "version": "3.0.0",
  "description": "Automated Minecraft Kit Delivery Bot for 2b2t, 6b6t, and anarchy servers. Supports TPA teleport, Elytra flight, chest scanning, and in-game whitelist commands.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/src/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "node backend/src/index.js",
    "install:all": "npm install && cd frontend && npm install",
    "backend": "node backend/src/index.js",
    "frontend": "cd frontend && npm run dev"
  },
  "keywords": [
    "minecraft-kit-delivery-bot",
    "2b2t-kit-bot",
    "6b6t-delivery-bot",
    "anarchy-server-kit-bot",
    "mineflayer-delivery-bot",
    "automated-kit-bot",
    "minecraft-shop-bot",
    "minecraft-item-delivery-bot",
    "elytra-delivery-bot",
    "minecraft-stash-delivery",
    "mineflayer",
    "2b2t",
    "6b6t"
  ],
  "author": "samirx69",
  "license": "ISC",
  "dependencies": {
    "@eksses/eafe": "^11.0.4",
    "@hono/node-server": "^2.0.11",
    "@types/better-sqlite3": "^7.6.13",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.1",
    "chalk": "^5.3.0",
    "cors": "^2.8.5",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "mineflayer": "^4.37.1",
    "mineflayer-auto-eat": "^3.3.6",
    "mineflayer-blockfinder": "^0.0.7",
    "mineflayer-collectblock": "^1.4.1",
    "mineflayer-navigate": "^0.0.10",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-web-inventory": "^1.8.5",
    "prismarine-viewer": "^1.28.0",
    "vec3": "^0.1.10",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14"
  }
}
